# ======================================================================
# HOME PLUMBING USA - HIGH-PERFORMANCE APACHE CONFIGURATION
# Canonical URL Routing, Trailing Slash Normalization & Static Precedence
# ======================================================================

DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. NORMALIZE DUPLICATE SLASHES (//+)
  # Redirect any request containing consecutive slashes to clean single slash
  # ----------------------------------------------------------------------
  # 1A. Handle multiple leading slashes (e.g. //alaska/... -> /alaska/...)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/{2,}([^\s?]*) [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 1B. Handle multiple internal slashes (e.g. /alaska//anchorage -> /alaska/anchorage)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+([^\s?]*?)/{2,}([^\s?]*) [NC]
  RewriteRule ^ %1/%2 [R=301,L,NE]

  # ----------------------------------------------------------------------
  # 2. CANONICAL INDEX.HTML STRIPPING
  # Redirect direct requests for index.html to clean trailing slash or root
  # ----------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.html(?:\s|\?) [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3. ENFORCE TRAILING SLASH ON PHYSICAL DIRECTORIES
  # Automatically 301 redirect directory paths lacking a trailing slash
  # so Apache resolves index.html natively and relative assets stay intact
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # ----------------------------------------------------------------------
  # 4. PRIORITIZE PHYSICAL FILES & STATIC HYPER-LOCAL DIRECTORIES
  # If an exact static folder, index.html, or file exists, serve it directly
  # and terminate rewrite processing immediately.
  # ----------------------------------------------------------------------
  # Static asset alias: /images/* -> public/images/*
  RewriteRule ^images/(.*)$ public/images/$1 [L]

  # Static blog hub handler
  RewriteRule ^blog/?$ blog/index.html [L]

  # Direct serving: existing physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Hyper-Local Static Routes (Explicit direct serving fallback)
  RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1/$2/$3/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2/index.html [L]

  # ----------------------------------------------------------------------
  # 5. URL PATH HYGIENE (SPACES, UNDERSCORES, HYPHENS, STATES, LOWERCASE)
  # Normalize PATH ONLY (strictly ignore query parameters to prevent loops)
  # ----------------------------------------------------------------------
  # Normalize spaces, %20, %25 to hyphens in PATH ONLY
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+\/+([^?\s]*)(?:%20|%2520|\s)([^?\s]*?)(?:\?[^\s]*)?\s+HTTP [NC]
  RewriteRule ^ /%1-%2 [R=301,L,NE]

  # Normalize underscores to hyphens in PATH ONLY
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+\/+([^?\s]*)_([^?\s]*?)(?:\?[^\s]*)?\s+HTTP [NC]
  RewriteRule ^ /%1-%2 [R=301,L,NE]

  # Normalize consecutive hyphens to a single hyphen in PATH ONLY
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+\/+([^?\s]*)--([^?\s]*?)(?:\?[^\s]*)?\s+HTTP [NC]
  RewriteRule ^ /%1-%2 [R=301,L,NE]

  # Normalize uppercase URI paths to lowercase (ignore static assets)
  RewriteCond %{REQUEST_URI} !\.(?:css|js|png|jpg|jpeg|gif|webp|avif|svg|woff2|woff|ico)$ [NC]
  RewriteCond expr "tolower(%{REQUEST_URI}) =~ /(.*)/"
  RewriteRule [A-Z] %1 [R=301,L]

  # Redirect bare state directories to state hubs
  RewriteRule ^(?:alaska|texas|florida|colorado)/?$ /state/$0/ [R=301,L,NC]

  # Remove .html extension globally from page requests (e.g. /about.html -> /about)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html(?:\s|\?) [NC]
  RewriteRule ^ %1 [R=301,L]

  # ----------------------------------------------------------------------
  # 6. DYNAMIC QUERY PARAMETER 301 REDIRECTS TO PHYSICAL STATIC DIRECTORIES
  # Map legacy query strings (?city=...&state=...&zip=...) to static folders:
  # https://homeplumbingusa.com/{state-slug}/{city-slug}-{zip}/{service-slug}/
  # ----------------------------------------------------------------------

  # Step 1: Normalize spaces (%20, +, and literal spaces) in QUERY_STRING to hyphens internally
  RewriteCond %{QUERY_STRING} ^(.*)(?:%20|\+|\s)(.*)$
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ $1?%1-%2 [N,NE]

  # Step 2: Lowercase query string into LOWER_QS environment variable
  RewriteCond expr "tolower(%{QUERY_STRING}) =~ /(.*)/"
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=LOWER_QS:%1]

  # Fallback if expr tolower is not available
  RewriteCond %{ENV:LOWER_QS} ^$
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=LOWER_QS:%{QUERY_STRING}]

  # Step 3: Resolve state code or name to lowercase state slug
  RewriteCond %{ENV:LOWER_QS} (?:^|&)state=(?:tx|texas)(?:&|$) [NC]
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=STATE_SLUG:texas]

  RewriteCond %{ENV:LOWER_QS} (?:^|&)state=(?:fl|florida)(?:&|$) [NC]
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=STATE_SLUG:florida]

  RewriteCond %{ENV:LOWER_QS} (?:^|&)state=(?:ak|alaska)(?:&|$) [NC]
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=STATE_SLUG:alaska]

  RewriteCond %{ENV:LOWER_QS} (?:^|&)state=(?:co|colorado)(?:&|$) [NC]
  RewriteRule ^(services(?:/.*)?|service-detail|service-detail\.html|city-zip|city-zip\.html)$ - [E=STATE_SLUG:colorado]

  # Step 4: Map /services/{service-slug}?city=...&state=...&zip=... to physical static directories
  # 4A. Drain Cleaning cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:clogged-drain-repair|drain-cleaning|hydro-jetting|drain-repair|rooter-services|drain-cleaning-service|hydro-jetting-service)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/drain-cleaning/? [R=301,L,NE]

  # 4B. Burst Pipe Repair cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:burst-pipe-repair|pipe-repair|pipe-leak-repair|whole-house-repiping|pipe-relining|pipe-replacement|pipe-insulation)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/burst-pipe-repair/? [R=301,L,NE]

  # 4C. Water Heater Repair cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:water-heater-repair|water-heater-installation|tankless-water-heater-installation|tankless-water-heater-repair)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/water-heater-repair/? [R=301,L,NE]

  # 4D. Sewer Line Repair cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:sewer-line-repair|sewer-line-replacement|drain-line-replacement|septic-tank-repair|septic-system-installation)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/sewer-line-repair/? [R=301,L,NE]

  # 4E. Emergency Plumbing cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:emergency-plumbing|24-hour-emergency-plumbing|same-day-plumbing-repair|toilet-repair.*)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/emergency-plumbing/? [R=301,L,NE]

  # 4F. Leak Detection cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:leak-detection|slab-leak-repair|plumbing-leak-detection|leak-detection-service)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/leak-detection/? [R=301,L,NE]

  # 4G. Gas Line Repair cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:gas-line-repair|gas-line-installation|gas-leak-detection)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/gas-line-repair/? [R=301,L,NE]

  # 4H. Water Line Repair cluster
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/(?:water-line-repair|water-line-installation|water-line-trenching)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/water-line-repair/? [R=301,L,NE]

  # 4I. Fallback for any other /services/{service-slug}
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^services/([^/]+)/?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/$1/? [R=301,L,NE]

  # 4J. City-ZIP Hub queries: /city-zip.html or /services with city, state, zip -> /{state}/{city}-{zip}/
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html)?$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/? [R=301,L,NE]

  # 4K. Service Detail queries: /service-detail.html?city=...&state=...&zip=...&service=...
  RewriteCond %{ENV:STATE_SLUG} !^$
  RewriteCond %{ENV:LOWER_QS} (?:^|&)city=([^&]+) [NC]
  RewriteCond %1::%{ENV:LOWER_QS} ^([^:]+)::.*(?:^|&)zip=(\d{5}|[^&]+) [NC]
  RewriteCond %1::%2::%{ENV:LOWER_QS} ^([^:]+)::([^:]+)::.*(?:^|&)service=([^&]+) [NC]
  RewriteRule ^(?:service-detail|service-detail\.html)$ https://homeplumbingusa.com/%{ENV:STATE_SLUG}/%1-%2/%3/? [R=301,L,NE]

  # 4L. State Only Query String Redirect: ?state=...
  RewriteCond %{QUERY_STRING} (?:^|&)state=(?:ak|alaska)(?:&|$) [NC]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ https://homeplumbingusa.com/state/alaska/? [R=301,L,NE]

  RewriteCond %{QUERY_STRING} (?:^|&)state=(?:tx|texas)(?:&|$) [NC]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ https://homeplumbingusa.com/state/texas/? [R=301,L,NE]

  RewriteCond %{QUERY_STRING} (?:^|&)state=(?:fl|florida)(?:&|$) [NC]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ https://homeplumbingusa.com/state/florida/? [R=301,L,NE]

  RewriteCond %{QUERY_STRING} (?:^|&)state=(?:co|colorado)(?:&|$) [NC]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ https://homeplumbingusa.com/state/colorado/? [R=301,L,NE]

  # 4M. Legacy Routes: /city/{state}/{city}/{zip} -> /{state}/{city}-{zip}/
  RewriteRule ^city/(?:ak|alaska)/([^/]+)/([^/]+)/?$ https://homeplumbingusa.com/alaska/$1-$2/ [R=301,L,NE]
  RewriteRule ^city/(?:tx|texas)/([^/]+)/([^/]+)/?$ https://homeplumbingusa.com/texas/$1-$2/ [R=301,L,NE]
  RewriteRule ^city/(?:fl|florida)/([^/]+)/([^/]+)/?$ https://homeplumbingusa.com/florida/$1-$2/ [R=301,L,NE]
  RewriteRule ^city/(?:co|colorado)/([^/]+)/([^/]+)/?$ https://homeplumbingusa.com/colorado/$1-$2/ [R=301,L,NE]

  # 4N. Legacy Routes: /service-areas/{state}-{city}-{zip} -> /{state}/{city}-{zip}/
  RewriteRule ^service-areas/ak-([^-]+(?:-[^-]+)*)-(\d{5})/?$ https://homeplumbingusa.com/alaska/$1-$2/ [R=301,L,NE]
  RewriteRule ^service-areas/tx-([^-]+(?:-[^-]+)*)-(\d{5})/?$ https://homeplumbingusa.com/texas/$1-$2/ [R=301,L,NE]
  RewriteRule ^service-areas/fl-([^-]+(?:-[^-]+)*)-(\d{5})/?$ https://homeplumbingusa.com/florida/$1-$2/ [R=301,L,NE]
  RewriteRule ^service-areas/co-([^-]+(?:-[^-]+)*)-(\d{5})/?$ https://homeplumbingusa.com/colorado/$1-$2/ [R=301,L,NE]


  # ----------------------------------------------------------------------
  # 7. STATE ROUTES
  # ----------------------------------------------------------------------
  # A. Serve static pre-rendered state page if available (state/<slug>/index.html)
  RewriteCond %{DOCUMENT_ROOT}/state/$1/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^state/([^/]+)/?$ state/$1/index.html [L]

  # B. Serve static html file if available (state/<slug>.html)
  RewriteCond %{DOCUMENT_ROOT}/state/$1.html -f
  RewriteRule ^state/([^/]+)/?$ state/$1.html [L]

  # C. Route to state.html
  RewriteRule ^state/([^/]+)/?$ state.html [L]

  # ----------------------------------------------------------------------
  # 8. CLEAN SERVICE ROUTES
  # ----------------------------------------------------------------------
  # A. Serve static pre-rendered service page if available (services/<slug>/index.html)
  RewriteCond %{DOCUMENT_ROOT}/services/$1/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^services/([^/]+)/?$ services/$1/index.html [L]

  # B. Serve static html file if available (services/<slug>.html)
  RewriteCond %{DOCUMENT_ROOT}/services/$1.html -f
  RewriteRule ^services/([^/]+)/?$ services/$1.html [L]

  # C. Route to service-detail.html
  RewriteRule ^services/([^/]+)/?$ service-detail.html [L]

  # ----------------------------------------------------------------------
  # 9. ROOT STATIC PAGE RESOLUTION (Extensionless .html fallback)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# --- Core Web Vitals Optimization: Gzip Compression & Cache Control ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|woff2|woff|css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
