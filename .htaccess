RewriteEngine On
RewriteBase /

# --- Server-Side 301 Redirect Rules for Clean Canonical Static URLs ---

# A. Redirect URLs containing spaces, %20, %25 or percent signs in the path
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)(?:\s|%25252520|%252520|%2520|%20|%2525|%25|%)(.*)\sHTTP [NC]
RewriteRule ^ /%1-%2 [R=301,L,NE]

# B. Redirect state or city URLs containing underscores to hyphens
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)_(.*)\sHTTP [NC]
RewriteRule ^ /%1-%2 [R=301,L,NE]

# C. Redirect state or city URLs containing consecutive hyphens to a single hyphen
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*)--(.*)\sHTTP [NC]
RewriteRule ^ /%1-%2 [R=301,L,NE]

# D. Redirect uppercase state names in state routes (e.g., /state/Alaska -> /state/alaska)
RewriteCond %{REQUEST_URI} ^/state/alaska$ [NC]
RewriteCond %{REQUEST_URI} !^/state/alaska$
RewriteRule ^ /state/alaska [R=301,L]

RewriteCond %{REQUEST_URI} ^/state/texas$ [NC]
RewriteCond %{REQUEST_URI} !^/state/texas$
RewriteRule ^ /state/texas [R=301,L]

RewriteCond %{REQUEST_URI} ^/state/florida$ [NC]
RewriteCond %{REQUEST_URI} !^/state/florida$
RewriteRule ^ /state/florida [R=301,L]

# --- 1. Query-Parameter Disabling: Redirect Query URLs to Physical Static Folders ---

# 1A. Alaska: /services/{service}?city={city}&state=ak&zip={zip} -> /alaska/{city}-{zip}/{canonical-service}/
RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:clogged-drain-repair|drain-cleaning|hydro-jetting|drain-repair|rooter-services|drain-cleaning-service|hydro-jetting-service)/?$ /alaska/%2-%1/drain-cleaning/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:burst-pipe-repair|pipe-repair|pipe-leak-repair|whole-house-repiping|pipe-relining|pipe-replacement|pipe-insulation)/?$ /alaska/%2-%1/burst-pipe-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-heater-repair|water-heater-installation|tankless-water-heater-installation|tankless-water-heater-repair)/?$ /alaska/%2-%1/water-heater-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:sewer-line-repair|sewer-line-replacement|drain-line-replacement|septic-tank-repair|septic-system-installation)/?$ /alaska/%2-%1/sewer-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:emergency-plumbing|24-hour-emergency-plumbing|same-day-plumbing-repair|toilet-repair.*)/?$ /alaska/%2-%1/emergency-plumbing/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:leak-detection|slab-leak-repair|plumbing-leak-detection|leak-detection-service)/?$ /alaska/%2-%1/leak-detection/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:gas-line-repair|gas-line-installation|gas-leak-detection)/?$ /alaska/%2-%1/gas-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-line-repair|water-line-installation|water-line-trenching)/?$ /alaska/%2-%1/water-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^services/([^/]+)/?$ /alaska/%2-%1/$1/? [R=301,L,NE]

# 1B. Texas: /services/{service}?city={city}&state=tx&zip={zip} -> /texas/{city}-{zip}/{canonical-service}/
RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:clogged-drain-repair|drain-cleaning|hydro-jetting|drain-repair|rooter-services|drain-cleaning-service|hydro-jetting-service)/?$ /texas/%2-%1/drain-cleaning/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:burst-pipe-repair|pipe-repair|pipe-leak-repair|whole-house-repiping|pipe-relining|pipe-replacement|pipe-insulation)/?$ /texas/%2-%1/burst-pipe-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-heater-repair|water-heater-installation|tankless-water-heater-installation|tankless-water-heater-repair)/?$ /texas/%2-%1/water-heater-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:sewer-line-repair|sewer-line-replacement|drain-line-replacement|septic-tank-repair|septic-system-installation)/?$ /texas/%2-%1/sewer-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:emergency-plumbing|24-hour-emergency-plumbing|same-day-plumbing-repair|toilet-repair.*)/?$ /texas/%2-%1/emergency-plumbing/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:leak-detection|slab-leak-repair|plumbing-leak-detection|leak-detection-service)/?$ /texas/%2-%1/leak-detection/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:gas-line-repair|gas-line-installation|gas-leak-detection)/?$ /texas/%2-%1/gas-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-line-repair|water-line-installation|water-line-trenching)/?$ /texas/%2-%1/water-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^services/([^/]+)/?$ /texas/%2-%1/$1/? [R=301,L,NE]

# 1C. Florida: /services/{service}?city={city}&state=fl&zip={zip} -> /florida/{city}-{zip}/{canonical-service}/
RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:clogged-drain-repair|drain-cleaning|hydro-jetting|drain-repair|rooter-services|drain-cleaning-service|hydro-jetting-service)/?$ /florida/%2-%1/drain-cleaning/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:burst-pipe-repair|pipe-repair|pipe-leak-repair|whole-house-repiping|pipe-relining|pipe-replacement|pipe-insulation)/?$ /florida/%2-%1/burst-pipe-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-heater-repair|water-heater-installation|tankless-water-heater-installation|tankless-water-heater-repair)/?$ /florida/%2-%1/water-heater-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:sewer-line-repair|sewer-line-replacement|drain-line-replacement|septic-tank-repair|septic-system-installation)/?$ /florida/%2-%1/sewer-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:emergency-plumbing|24-hour-emergency-plumbing|same-day-plumbing-repair|toilet-repair.*)/?$ /florida/%2-%1/emergency-plumbing/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:leak-detection|slab-leak-repair|plumbing-leak-detection|leak-detection-service)/?$ /florida/%2-%1/leak-detection/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:gas-line-repair|gas-line-installation|gas-leak-detection)/?$ /florida/%2-%1/gas-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/(?:water-line-repair|water-line-installation|water-line-trenching)/?$ /florida/%2-%1/water-line-repair/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^services/([^/]+)/?$ /florida/%2-%1/$1/? [R=301,L,NE]

# 1D. Service Detail Query String Redirect: /service-detail.html?city=...&state=...&zip=...&service=...
RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)service=([^&]+)::(.*)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2::%3 (?:^|&)state=(?:ak|alaska)::(.*)::(.*)::(.*) [NC]
RewriteRule ^(?:service-detail|service-detail\.html)?$ /alaska/%3-%2/%1/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)service=([^&]+)::(.*)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2::%3 (?:^|&)state=(?:tx|texas)::(.*)::(.*)::(.*) [NC]
RewriteRule ^(?:service-detail|service-detail\.html)?$ /texas/%3-%2/%1/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)service=([^&]+)::(.*)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2::%3 (?:^|&)state=(?:fl|florida)::(.*)::(.*)::(.*) [NC]
RewriteRule ^(?:service-detail|service-detail\.html)?$ /florida/%3-%2/%1/? [R=301,L,NE]

# 1E. City-ZIP Hub queries: /city-zip.html?state=...&city=...&zip=... -> /{state}/{city}-{zip}/
RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:ak|alaska)::(.*)::(.*) [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html)?$ /alaska/%2-%1/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:tx|texas)::(.*)::(.*) [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html)?$ /texas/%2-%1/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)city=([^&]+) [NC]
RewriteCond %{QUERY_STRING}::%1 (?:^|&)zip=([^&]+)::(.*) [NC]
RewriteCond %{QUERY_STRING}::%1::%2 (?:^|&)state=(?:fl|florida)::(.*)::(.*) [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html)?$ /florida/%2-%1/? [R=301,L,NE]

# 1F. State Only Query String Redirect: ?state=...
RewriteCond %{QUERY_STRING} (?:^|&)state=(?:ak|alaska) [NC]
RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ /state/alaska/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)state=(?:tx|texas) [NC]
RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ /state/texas/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} (?:^|&)state=(?:fl|florida) [NC]
RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
RewriteRule ^(?:city-zip|city-zip\.html|services|services\.html|state|state\.html)?$ /state/florida/? [R=301,L,NE]

# 1G. Legacy Route: /city/{state}/{city}/{zip} -> /{state}/{city}-{zip}/
RewriteRule ^city/(?:ak|alaska)/([^/]+)/([^/]+)/?$ /alaska/$1-$2/ [R=301,L,NE]
RewriteRule ^city/(?:tx|texas)/([^/]+)/([^/]+)/?$ /texas/$1-$2/ [R=301,L,NE]
RewriteRule ^city/(?:fl|florida)/([^/]+)/([^/]+)/?$ /florida/$1-$2/ [R=301,L,NE]

# 1H. Legacy Route: /service-areas/{ak|tx|fl}-{city}-{zip} -> /{state}/{city}-{zip}/
RewriteRule ^service-areas/ak-([^-]+(?:-[^-]+)*)-(\d{5})/?$ /alaska/$1-$2/ [R=301,L,NE]
RewriteRule ^service-areas/tx-([^-]+(?:-[^-]+)*)-(\d{5})/?$ /texas/$1-$2/ [R=301,L,NE]
RewriteRule ^service-areas/fl-([^-]+(?:-[^-]+)*)-(\d{5})/?$ /florida/$1-$2/ [R=301,L,NE]

# --- 2. Static Asset and Core Routing ---

# Rewrite /images/* requests to public/images/*
RewriteRule ^images/(.*)$ public/images/$1 [L]

# Remove .html extension globally
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# --- 3. Hyper-Local Physical Static Routes (Direct Serving) ---

# 3A. Hyper-Local Static Service Pages (e.g., /alaska/anchorage-99507/drain-cleaning/)
RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3/index.html -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1/$2/$3/index.html [L]

# 3B. Hyper-Local City-ZIP Hub Pages (e.g., /alaska/anchorage-99507/)
RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f
RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2/index.html [L]

# --- 4. State Routes ---

# A. Serve static pre-rendered state page if available (state/<slug>/index.html)
RewriteCond %{DOCUMENT_ROOT}/state/$1/index.html -f
RewriteRule ^state/([^/]+)/?$ state/$1/index.html [L]

# B. Serve static html file if available (state/<slug>.html)
RewriteCond %{DOCUMENT_ROOT}/state/$1.html -f
RewriteRule ^state/([^/]+)/?$ state/$1.html [L]

# C. Route to state.html
RewriteRule ^state/([^/]+)/?$ state.html [L]

# --- 5. Clean Service Routes ---

# A. Serve static pre-rendered service page if available (services/<slug>/index.html)
RewriteCond %{DOCUMENT_ROOT}/services/$1/index.html -f
RewriteRule ^services/([^/]+)/?$ services/$1/index.html [L]

# B. Serve static html file if available (services/<slug>.html)
RewriteCond %{DOCUMENT_ROOT}/services/$1.html -f
RewriteRule ^services/([^/]+)/?$ services/$1.html [L]

# C. Route to service-detail.html
RewriteRule ^services/([^/]+)/?$ service-detail.html [L]

# --- 6. Fallback to check if actual file exists without extension ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# --- Core Web Vitals Optimization: Gzip Compression & Cache Control ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|woff2|woff|css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
